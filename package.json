{
  "name": "ashis-kirti-love-space",
  "version": "1.0.0",
  "description": "Private couple memory space exclusively for Ashis and Kirti",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
