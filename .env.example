# Application Port
PORT=5000

# Node Environment ('production' for live deployment)
NODE_ENV=production

# MongoDB Atlas Database URI (replace with your MongoDB Atlas cluster URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ashis_kirti_love?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ashis_kirti_love?retryWrites=true&w=majority

# JWT Secrets for 30-Day Protected Persistent Session
JWT_ACCESS_SECRET=ashis_kirti_super_secret_access_key_2026_romantic_love_space
JWT_REFRESH_SECRET=ashis_kirti_super_secret_refresh_key_2026_forever_session

# Client URL (URL where your frontend is deployed)
# For full-stack single deployment (e.g. Render): leave as your Render domain (e.g. https://ashis-kirti-love.onrender.com)
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Configuration for Image/Video Vault storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
